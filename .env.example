[TEMPLATE]
# InTab Vault Encryption Secret (Pepper)
# Set your unique application key here
VITE_VAULT_KEY=intab_sec_change_this_to_your_unique_key

# ── Premium Cloud Sync ──────────────────────────────────────
# Lemon Squeezy $3/mo subscription product → license keys.

# Browser-side OAuth client ids (safe to expose — PKCE public clients)
VITE_MSFT_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ── GitHub Agent Mode (Chat) ────────────────────────────────
# OAuth App client id (safe to expose; the secret stays server-side).
# Create one at github.com/settings/developers with callback URL
# https://<your-domain>/api/github (add http://localhost:5173/api/github for dev).
VITE_GITHUB_CLIENT_ID=

# Buy Me a Coffee handle for free-user support (e.g. "intab" → buymeacoffee.com/intab)
VITE_BMC_HANDLE=intab

# ── Server-side secrets (Vercel env vars — NEVER prefix with VITE_) ──
# Lemon Squeezy API key used by /api/license edge function
LEMON_SQUEEZY_API_KEY=

# GitHub OAuth App credentials used by /api/github edge function
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
