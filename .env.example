[TEMPLATE]
# ============================================================
# Environment — Every Variable This App Reads
# ============================================================
# Two rules decide where a value goes:
#
#   VITE_*   → compiled into the browser bundle. PUBLIC. Anyone can read it.
#   no VITE_ → server side only (Vercel function env, or the dev server).
#              Never give a secret the VITE_ prefix.
#
# Local development reads this file. A deployment reads the project's
# environment variables on Vercel. Both are listed below in the same order.

# ── Client (public — VITE_ prefix) ──────────────────────────

# Local vault encryption pepper. Change it from the default.
VITE_VAULT_KEY=intab_sec_change_this_to_your_unique_key

# OAuth client ids. Public by design: these are PKCE public clients, and the
# secret half lives server-side (GITHUB_CLIENT_SECRET below).
VITE_MSFT_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ── GitHub Agent Mode (the chat) ────────────────────────────
# OAuth App client id (public). Create it at github.com/settings/developers
# with callback URL https://<your-domain>/api/github
# (add http://localhost:5173/api/github for local dev).
VITE_GITHUB_CLIENT_ID=

# Buy Me a Coffee handle for free-user support (e.g. "intab" → buymeacoffee.com/intab)
VITE_BMC_HANDLE=intab

# ── Server-side secrets (never prefix these with VITE_) ─────

# GitHub OAuth exchange, used by /api/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Lemon Squeezy API key, used by /api/license to activate/validate the
# license key. The license key also derives the cloud-sync encryption key,
# so removing this breaks cloud sync's key derivation, not just licensing.
LEMON_SQUEEZY_API_KEY=

# ── Web search (the agent's search_web tool) ────────────────
# Set ONE. Search works with no other change: the key's presence is what
# enables the tool, and the agent then reports which provider answered.
#
# In local dev the key is re-read on every search, so adding it here takes
# effect without restarting the dev server.
#
# Must NOT be prefixed with VITE_ — that would ship the key to the browser.

# Tavily — 1,000 searches/month free, no card. Recommended default.
# https://tavily.com
TAVILY_API_KEY=

# Brave Search — $5 of monthly credit (the free plan was retired in 2026).
# https://api-dashboard.search.brave.com
BRAVE_API_KEY=

# Exa — starter credit on signup. https://exa.ai
EXA_API_KEY=

# Serper — 2,500 one-time searches. https://serper.dev
SERPER_API_KEY=

# Only needed when MORE THAN ONE key above is set: pins which provider is
# used. One of: tavily | brave | exa | serper
SEARCH_PROVIDER=

# ── Local runtime (optional, dev machine only) ──────────────
# The companion runs the project's REAL toolchain on your machine: the commands
# `run_command` uses (install, build, test, lint, typecheck) in a throwaway tree
# per conversation, never in your own checkout.
#
# TWO SIDES, TWO NAMES — this is the part that reads like a mistake and is not:
#   VITE_COMPANION_*   is read by the APP. Vite only exposes VITE_-prefixed
#                      variables to the browser, so the app's copy needs it.
#   COMPANION_*        is read by the COMPANION PROCESS itself (COMPANION_TOKEN,
#                      COMPANION_PORT, …). It never sees VITE_* values.
#
# Start it with `npm run companion`; it prints both values:
#
#   Companion listening on http://127.0.0.1:5280 (loopback only)
#   Pairing token — paste it into the app and restart the dev server:
#     VITE_COMPANION_ORIGIN=http://127.0.0.1:5280
#     VITE_COMPANION_TOKEN=9f2c…
#
# Paste those two lines here, then restart `npm run dev`. In development the
# ORIGIN can be left empty — the app falls back to http://127.0.0.1:5280 — so
# only the token has to be a value.
VITE_COMPANION_ORIGIN=
VITE_COMPANION_TOKEN=

# Pin the token so restarting the companion does not invalidate what you pasted.
# Set it here, start the companion with the same file, and both sides agree with
# no copying at all:
#
#   COMPANION_TOKEN=choose-something-long-and-random
#   npm run companion        # runs: node --env-file-if-exists=.env.local …
#
# `--env-file-if-exists` is why this is safe to leave empty: no .env.local, no
# error, just a freshly generated token.
COMPANION_TOKEN=

# Port, tree directory and allowlist for the companion (defaults are fine).
# COMPANION_APP_ORIGINS is which pages may drive the companion; loopback origins
# are always allowed, so a local dev server needs nothing added here.
COMPANION_PORT=
COMPANION_TREES_DIR=
COMPANION_APP_ORIGINS=
